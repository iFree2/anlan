  "database_verification": {
    "server_version": "17.11",
    "database": "anlan_dev",
    "schema": "public",
    "extversion": "0.8.6",
    "create_sql": "CREATE EXTENSION IF NOT EXISTS vector WITH SCHEMA public",
    "cosine_sql": "SELECT label, embedding OPERATOR(public.<=>) '[1,0,0]'::public.vector\n    AS cosine_distance\nFROM (VALUES ('same', '[1,0,0]'::public.vector),\n             ('orthogonal', '[0,1,0]'::public.vector),\n             ('opposite', '[-1,0,0]'::public.vector)) AS samples(label, embedding)\nORDER BY cosine_distance, label",
    "cosine_results": [
      {
        "label": "same",
        "cosine_distance": 0.0
      },
      {
        "label": "orthogonal",
        "cosine_distance": 1.0
      },
      {
        "label": "opposite",
        "cosine_distance": 2.0
      }
    ]
  }
